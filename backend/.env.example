ASYNC_EXTRACTION_BACKEND_CALLBACK_URL=
ASYNC_EXTRACTION_CALLBACK_TOKEN=
ASYNC_EXTRACTION_OCR_MODE=hybrid
LOCAL_ASYNC_EXTRACTION_WORKER_ENABLED=true
LOCAL_ASYNC_EXTRACTION_POLL_SECONDS=3
LOCAL_ASYNC_EXTRACTION_BATCH_SIZE=4
OCR_ENABLED=true
USE_UNSTRUCTURED_PARTITION=false
TESSERACT_CMD=
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
GOOGLE_VISION_CREDENTIALS_FILE=
GOOGLE_VISION_SCOPE=https://www.googleapis.com/auth/cloud-platform
GOOGLE_MAPS_API_KEY=
IMAGE_OCR_MODE=auto
SERVICE_CENTER_DIRECTORY_PATH=
SERVICE_CENTER_LIVE_LOOKUP_ENABLED=true
SERVICE_CENTER_GOOGLE_LOOKUP_ENABLED=true
MAX_CHUNKS_PER_DOCUMENT=1500
MAX_SEARCH_RESULTS=25
PROMPT_INJECTION_BLOCKING=true
