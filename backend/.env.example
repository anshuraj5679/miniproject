APP_NAME=SafeBill RAG API
ENVIRONMENT=dev
AWS_ONLY_MODE=true
AUTH_PROVIDER=cognito
AI_PROVIDER=bedrock
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SECRETS_ENABLED=false
AWS_SECRETS_MANAGER_SECRET_ID=
AWS_SSM_PARAMETER_PREFIX=
AWS_SSM_RECURSIVE=true
AWS_SSM_WITH_DECRYPTION=true
# Local Postgres: postgresql+psycopg://postgres:postgres@localhost:5432/safebill
# Neon Postgres: postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/safebill
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
BEDROCK_CHAT_MODEL=apac.anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_TEXT_MAPPING_ENABLED=true
BEDROCK_IMAGE_REGION=
BEDROCK_IMAGE_MODEL=amazon.titan-image-generator-v2:0
PRODUCT_IMAGE_GENERATION_ENABLED=true
PRODUCT_IMAGE_WIDTH=768
PRODUCT_IMAGE_HEIGHT=768
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=
S3_KEY_PREFIX=documents
S3_PRESIGN_TTL_SECONDS=900
S3_FORCE_PATH_STYLE=false
S3_REQUIRE_UPLOAD_SUCCESS=true
DYNAMODB_MIRROR_ENABLED=false
DYNAMODB_READ_FALLBACK_ENABLED=true
DYNAMODB_DOCUMENTS_TABLE_NAME=
DYNAMODB_EXTRACTION_JOBS_TABLE_NAME=
DYNAMODB_USER_CREATED_AT_INDEX_NAME=user_id-created_at-index
DYNAMODB_MERCHANT_CREATED_AT_INDEX_NAME=merchant_user_id-created_at-index
ASYNC_EXTRACTION_ENABLED=false
