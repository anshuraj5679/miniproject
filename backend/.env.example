APP_NAME=SafeBill RAG API
# dev | production. In production the API refuses to start without a working DATABASE_URL.
ENVIRONMENT=dev
AWS_ONLY_MODE=false

# --- Auth: Supabase (Project Settings -> API) ---
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy HS256 projects; modern projects are verified via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents

# Optional static service tokens -> roles (JSON). Empty by default; every entry bypasses
# user-level auth, so use long random secrets only.
# AUTH_TOKENS={"<long-random-secret>": "analyst"}

# --- Database: Supabase Postgres (Settings -> Database -> Connection string) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/safebill

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# --- AI: OpenRouter (the GEMINI_* names are kept for compatibility) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=openrouter/free
# Emergency key: used automatically when the key above is rejected, out of credit or rate-limited.
OPENROUTER_BACKUP_API_KEY=
# Model for image OCR/extraction; must accept image input. Empty = GEMINI_MODEL.
OPENROUTER_VISION_MODEL=
OPENROUTER_TIMEOUT_SECONDS=40

# --- Claude (Anthropic) - console.anthropic.com; needs API credits ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_CHAT_EFFORT=medium

# --- Google Gemini, direct (aistudio.google.com) ---
GOOGLE_GEMINI_API_KEY=
# Pro models need billing enabled; Flash works on the free tier.
GOOGLE_GEMINI_MODEL=gemini-3.6-flash
GOOGLE_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Image extraction runs every configured engine (Claude, Gemini, OpenRouter) in parallel
# and votes per field. Chat uses the first provider in this list that answers.
LLM_PROVIDER_ORDER=claude,gemini,openrouter
LLM_CHAT_BUDGET_SECONDS=45

# --- Storage ---
STORAGE_PROVIDER=supabase

# --- Scanning ---
ASYNC_EXTRACTION_ENABLED=true
LOCAL_ASYNC_EXTRACTION_WORKER_ENABLED=true
LOCAL_ASYNC_EXTRACTION_POLL_SECONDS=3
LOCAL_ASYNC_EXTRACTION_BATCH_SIZE=4
OCR_ENABLED=true
IMAGE_OCR_MODE=auto
GOOGLE_VISION_API_KEY=
GOOGLE_MAPS_API_KEY=
SERVICE_CENTER_LIVE_LOOKUP_ENABLED=true
SERVICE_CENTER_GOOGLE_LOOKUP_ENABLED=true

# --- Notifications (email uses AWS SES; also required for "Recover my ID") ---
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=ses
SES_REGION=
EMAIL_FROM=
EMAIL_FROM_NAME=SafeBill
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMS_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
WHATSAPP_NOTIFICATIONS_ENABLED=false
NOTIFICATION_DEFAULT_ALERT_DAYS=30,7,1
NOTIFICATION_CLAIM_ALERT_DAYS=14,3

# --- Optional features ---
PRODUCT_IMAGE_GENERATION_ENABLED=false
DYNAMODB_MIRROR_ENABLED=false
DYNAMODB_READ_FALLBACK_ENABLED=false

# Optional AWS providers (Bedrock, S3, DynamoDB) remain available through AI_PROVIDER /
# STORAGE_PROVIDER; see backend/infra/AWS_DEPLOY.md. The web app signs in with Supabase only.
