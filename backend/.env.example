APP_NAME=SafeBill RAG API
ENVIRONMENT=dev
# Local Postgres: postgresql+psycopg://postgres:postgres@localhost:5432/safebill
# Neon Postgres: postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/safebill
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
USE_PINECONE=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
PINECONE_TOP_K_MULTIPLIER=4
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
OCR_ENABLED=true
USE_UNSTRUCTURED_PARTITION=false
TESSERACT_CMD=
GOOGLE_MAPS_API_KEY=
ENABLE_GOOGLE_SERVICE_CENTER_LOOKUP=false
SERVICE_CENTER_DIRECTORY_PATH=
MAX_CHUNKS_PER_DOCUMENT=1500
MAX_SEARCH_RESULTS=25
PROMPT_INJECTION_BLOCKING=true
EMAIL_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
WHATSAPP_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=
EMAIL_FROM_NAME=SafeBill
NOTIFICATION_DEFAULT_ALERT_DAYS=30,7,1
NOTIFICATION_CLAIM_ALERT_DAYS=14,3
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_POLL_SECONDS=60
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BACKOFF_MINUTES=15
NOTIFICATION_WEBHOOK_SECRET=
SMS_WEBHOOK_URL=
PUSH_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
