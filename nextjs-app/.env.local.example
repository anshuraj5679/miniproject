# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Next.js internal API base (usually keep this as /api)
NEXT_PUBLIC_APP_API_BASE_URL=/api

# Backend API origin. Examples:
# Local: http://localhost:8000
# Render: https://your-backend.onrender.com
BACKEND_API_BASE_URL=http://localhost:8000

# Optional server-to-server token. Must match a key in the backend's AUTH_TOKENS.
# Leave empty unless a route has to call the backend without a signed-in user.
BACKEND_API_SERVICE_TOKEN=

# Backend proxy timeout. Keep below the hosting function limit (Vercel: 60s).
BACKEND_API_TIMEOUT_MS=55000

# Optional Google Vision OCR microservice (vision-ocr-service/). Ignored in production
# when it points at localhost.
VISION_OCR_BASE_URL=http://127.0.0.1:8080

# Images are scanned through the backend's async job queue (recommended; avoids 504s).
SCAN_USE_ASYNC_PIPELINE=true
