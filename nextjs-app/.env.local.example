NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3001/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3001/login
NEXT_PUBLIC_COGNITO_SCOPE=openid email profile
COGNITO_REGION=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REDIRECT_URI=http://localhost:3001/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3001/login
COGNITO_SCOPE=openid email profile

# Next.js internal API base (usually keep this as /api)
NEXT_PUBLIC_APP_API_BASE_URL=/api

# Backend RAG API origin. Examples:
# Local: http://localhost:8000
# Render/Fly/Railway: https://your-backend-domain
BACKEND_API_BASE_URL=http://localhost:8000

# Optional local Vision OCR microservice used by /api/scan in cloud OCR mode.
VISION_OCR_BASE_URL=http://127.0.0.1:8080

# Optional fallback token for server-to-server jobs only.
BACKEND_API_SERVICE_TOKEN=

# Optional timeout for backend proxy requests.
BACKEND_API_TIMEOUT_MS=45000
