NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Next.js internal API base (usually keep this as /api)
NEXT_PUBLIC_APP_API_BASE_URL=/api

# Backend RAG API origin. Examples:
# Local: http://localhost:8000
# Render/Fly/Railway: https://your-backend-domain
BACKEND_API_BASE_URL=http://localhost:8000

# Optional fallback token for server-to-server jobs only.
BACKEND_API_SERVICE_TOKEN=

# Optional timeout for backend proxy requests.
BACKEND_API_TIMEOUT_MS=45000
