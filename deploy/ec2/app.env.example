# Public host values
APP_BASE_URL=http://YOUR_EC2_PUBLIC_IP
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# Backend core
APP_NAME=SafeBill RAG API
ENVIRONMENT=prod
AWS_ONLY_MODE=true
AUTH_PROVIDER=cognito
AI_PROVIDER=bedrock
STORAGE_PROVIDER=s3
EMAIL_PROVIDER=ses
SMS_PROVIDER=sns
PUSH_PROVIDER=sns
WHATSAPP_PROVIDER=sns
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ANTHROPIC_KEY=
AWS_AMAZONNOVA_KEY=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/safebill?sslmode=require
CORS_ALLOW_CREDENTIALS=false

# Cognito backend verification
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWT_ISSUER=
COGNITO_JWT_AUDIENCE=

# Cognito frontend/server auth
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-2
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://YOUR_EC2_PUBLIC_IP/login
NEXT_PUBLIC_COGNITO_SCOPE=openid email profile
NEXT_PUBLIC_APP_API_BASE_URL=/api
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP/api/v1

COGNITO_REGION=ap-southeast-2
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP/auth/callback
COGNITO_LOGOUT_URI=http://YOUR_EC2_PUBLIC_IP/login
COGNITO_SCOPE=openid email profile

# Frontend -> backend proxy
BACKEND_API_SERVICE_TOKEN=safebill-analyst-token
BACKEND_API_TIMEOUT_MS=45000

# OCR + AWS AI
GOOGLE_VISION_CREDENTIALS_FILE=
GOOGLE_VISION_CREDENTIALS_HOST_PATH=./secrets/google-vision.json
GOOGLE_VISION_API_KEY=
GOOGLE_MAPS_API_KEY=
BEDROCK_CHAT_MODEL=amazon.nova-pro-v1:0
BEDROCK_TEXT_MAPPING_ENABLED=true
BEDROCK_IMAGE_MODEL=amazon.titan-image-generator-v2:0
BEDROCK_IMAGE_REGION=us-east-1
PRODUCT_IMAGE_GENERATION_ENABLED=true

# S3 / async extraction
S3_BUCKET_NAME=
S3_KEY_PREFIX=documents
S3_PRESIGN_TTL_SECONDS=900
S3_REQUIRE_UPLOAD_SUCCESS=true
ASYNC_EXTRACTION_ENABLED=true
LOCAL_ASYNC_EXTRACTION_WORKER_ENABLED=true
LOCAL_ASYNC_EXTRACTION_POLL_SECONDS=2
LOCAL_ASYNC_EXTRACTION_BATCH_SIZE=4
ASYNC_EXTRACTION_OCR_MODE=hybrid

# Service center lookup
SERVICE_CENTER_LIVE_LOOKUP_ENABLED=true
SERVICE_CENTER_GOOGLE_LOOKUP_ENABLED=true

# Messaging
SES_REGION=ap-southeast-2
EMAIL_FROM=
EMAIL_FROM_NAME=SafeBill
SNS_REGION=ap-southeast-2

# Optional DynamoDB mirrors
DYNAMODB_MIRROR_ENABLED=false
DYNAMODB_READ_FALLBACK_ENABLED=false
DYNAMODB_DOCUMENTS_TABLE_NAME=
DYNAMODB_EXTRACTION_JOBS_TABLE_NAME=
